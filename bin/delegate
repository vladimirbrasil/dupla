#!/usr/bin/env bash
# delegate — entrega uma tarefa braçal/pesada ao Antigravity CLI (agy), headless.
#
# Filosofia: o agente faz TODO o trabalho no disco (lendo, editando, RODANDO
# comandos e verificando) e devolve SÓ um resumo curto. O montão de tokens
# (diffs, logs) nunca entra no contexto de quem chamou (o Claude). A saída crua
# fica salva em .handoff/.
#
# Backend: Antigravity CLI (`agy`), que roda na assinatura Google AI Pro/Ultra
# (login OAuth, sem API paga). Substituiu o gemini-cli, que a Google cortou do
# tier individual/AI Pro em 18/06/2026 ("migrate to Antigravity"). Diferente do
# gemini-cli (one-shot burro), o agy é um AGENTE: planeja, usa ferramentas de
# arquivo/shell, executa de verdade e itera — então o delegate manda EXECUTAR e
# VERIFICAR, não simular.
#
# Uso:
#   delegate "refatore os 12 componentes para usar o novo hook useX"
#   delegate --think high "<tarefa difícil ou longa; gasta ~3× a cota>"
#   delegate --redo "ficou faltando o arquivo X; corrija"   # re-delega na MESMA
#                                                            # conversa (--continue)
#   echo "tarefa longa..." | delegate
#
# Flags, variáveis de ambiente e códigos de saída: 'delegate --help' (fonte única).
set -euo pipefail

# --- parse de flags (em qualquer ordem, antes do briefing) ------------------
#   --think low|med|high  → esforço de raciocínio do Gemini 3.8 Flash (default: low)
#       pro = RECUSADO: o Gemini 3.1 Pro saiu do agy 1.3.4 (ver nota abaixo)
#   --redo (alias --continue) → re-delega CONTINUANDO a última conversa do agy
#       (o agente lembra o que já fez; passe só a correção, sem re-briefar tudo)
THINK=""
CONTINUE=""
# 19/10/2026: bancada com medição real de tokens (bench/RESULTADOS.md) elegeu o Gemini 4 Argon Low
# (gemini-4-argon-low). Entregou diff 100% limpo com 51k tokens de entrada e 165k de volume total de
# contexto (contra 198k/713k do 3.8 Flash Low — 77% de economia de cota/tokens), e f2 em apenas 52s.
MODELO_PADRAO="gemini-4-argon-low"
# Fallback automático de cota: quando gerações distintas têm cotas separadas no Antigravity
# (ex.: Gemini 4 Argon vs Gemini 3.8 Flash), ativar Fallback="1" permite que o delegate tente
# automaticamente o modelo equivalente do 3.8 Flash se o Argon devolver RESOURCE_EXHAUSTED / 429.
# Quando o Google unificar a cota de todos os modelos, basta mudar o default abaixo para "0" (ou vazio).
FALLBACK_COTA_SEPARADA="${DELEGATE_QUOTA_FALLBACK:-1}"
TIMEOUT_PADRAO="30m"
HANDOFF_DIR="${HANDOFF_DIR:-.handoff}"

ajuda() {
  cat <<EOF
delegate — entrega uma tarefa braçal ao Antigravity CLI (agy) e devolve só um resumo.

USO
  delegate "<briefing>"                 modelo de trabalho ($MODELO_PADRAO)
  delegate --think high "<...>"         tarefa difícil/longa, ou retrabalho no diff
  DELEGATE_MODEL=<slug> delegate "<...>"  outro modelo (ex.: tarefa difícil ou longa)
  delegate --redo "<correção>"          continua a MESMA conversa (alias: --continue)
  echo "<briefing>" | delegate          briefing por stdin
  delegate -- "-briefing"               briefing que começa com hífen
  delegate --help                       esta ajuda (não inicia nada)

  Briefing longo: escreva num arquivo e passe "Execute o briefing em <caminho>".

ATENÇÃO
  • O agente roda com --dangerously-skip-permissions no diretório atual e EDITA arquivos.
    Não edite o mesmo repo enquanto ele roda: ele regrava por cima.
  • Exit 0 NÃO garante que deu certo: confira o efeito no disco (git status / git diff)
    e revise o diff linha a linha — o resumo omite.
  • Confira no stderr a linha "delegate: modelo = <slug>".

SAÍDA
  \$HANDOFF_DIR/agy-<data>-<hora>.txt   resposta completa do agente (.err = stderr)
  exit 0 terminou · 1 agy falhou, devolveu vazio ou timeout (pode haver trabalho PARCIAL
  no disco) · 2 uso inválido · 127 agy não instalado

VARIÁVEIS DE AMBIENTE (valor em uso agora)
  DELEGATE_MODEL=${DELEGATE_MODEL:-$MODELO_PADRAO}   ignorado com --think; ver 'agy models'
  DELEGATE_QUOTA_FALLBACK=$FALLBACK_COTA_SEPARADA          1 = cai p/ 3.8 Flash se cota do 4 Argon acabar (0 = desliga)
  DELEGATE_TIMEOUT=${DELEGATE_TIMEOUT:-$TIMEOUT_PADRAO}                   timeout do print mode do agy
  HANDOFF_DIR=$HANDOFF_DIR                   onde a saída é salva
EOF
}

while [ $# -gt 0 ]; do
  case "${1:-}" in
    --think)            THINK="${2:-}"; shift 2 ;;
    --redo|--continue)  CONTINUE="--continue"; shift ;;
    -h|--help)          # responder AQUI — jamais mandar '--help' como tarefa ao agy
                        ajuda; exit 0 ;;
    --)                 shift; break ;;
    -*)                 # idem para '--version', '--dry-run' etc.: nada que comece com '-'
                        # segue como briefing, a não ser depois de '--'
                        echo "delegate: opção desconhecida '${1%%$'\n'*}'. Veja: delegate --help" >&2
                        echo "          (briefing que começa com hífen: delegate -- \"<briefing>\")" >&2
                        exit 2 ;;
    *)                  break ;;
  esac
done
if [ $# -gt 1 ]; then
  echo "delegate: $# argumentos; o briefing é UM só — faltaram as aspas? Veja: delegate --help" >&2
  exit 2
fi
# Modelo default: **Gemini 4 Argon (Low)** — eleito em 19/10/2026.
# Na bancada (bench/RESULTADOS.md), foi o modelo mais econômico em tokens/cota:
# consumiu 77% menos tokens de contexto que o 3.8 Flash Low (165k vs 713k) e resolveu
# as duas fixtures com 31 passos (contra 72 passos do 3.8), gabaritando 3/3 testes e 5/5
# no juiz oculto.
#
# Histórico de defaults anteriores:
#   - Gemini 3.8 Flash (Low): 13/10 a 19/10/2026 (substituiu o 3.7 Flash)
#   - Gemini 3.7 Flash (High): 10/09 a 13/10/2026
#   - Gemini 3.6 Flash (High): 30/07 a 10/09/2026
#   - Gemini 3.1 Pro (High): antes de 30/07/2026
#
# `--think pro` apontava para o Gemini 3.1 Pro, que o agy não lista mais.
case "$THINK" in
  low)      MODEL="gemini-4-argon-low" ;;
  med)      MODEL="gemini-4-argon-medium" ;;
  high)     MODEL="gemini-4-argon-high" ;;
  pro)      echo "delegate: RECUSADO — '--think pro' usava o Gemini 3.1 Pro, que saiu do agy (13/10/2026; 'agy models' não o lista)." >&2
            echo "           Use '--think high' (Gemini 4 Argon High) ou DELEGATE_MODEL=<slug de 'agy models'>." >&2
            exit 2 ;;
  "")       MODEL="${DELEGATE_MODEL:-$MODELO_PADRAO}" ;;
  *) echo "delegate: --think inválido '$THINK' (use low|med|high)" >&2; exit 2 ;;
esac
case "$MODEL" in
  *3.5-flash*|*3\.5\ Flash*) echo "delegate: RECUSADO — '$MODEL' é o 3.5 Flash (incidente de 22/07/2026)." >&2; exit 2 ;;
esac

# Determina o modelo de fallback caso a cota separada esteja ativa (FALLBACK_COTA_SEPARADA=1)
# e o usuário não tenha fixado manualmente um DELEGATE_MODEL específico de outra família.
FALLBACK_MODEL=""
if [ "$FALLBACK_COTA_SEPARADA" = "1" ] && [ -z "${DELEGATE_MODEL:-}" ]; then
  case "$MODEL" in
    gemini-4-argon-low)    FALLBACK_MODEL="gemini-3.8-flash-low" ;;
    gemini-4-argon-medium) FALLBACK_MODEL="gemini-3.8-flash-medium" ;;
    gemini-4-argon-high)   FALLBACK_MODEL="gemini-3.8-flash-high" ;;
  esac
fi

mkdir -p "$HANDOFF_DIR"
TS="$(date +%Y%m%d-%H%M%S)"
RESULT="$HANDOFF_DIR/agy-$TS.txt"
ERR="$HANDOFF_DIR/agy-$TS.err"

if ! command -v agy >/dev/null 2>&1; then
  echo "ERRO: 'agy' (Antigravity CLI) não está instalado/no PATH." >&2
  echo "Instale: curl -fsSL https://antigravity.google/cli/install.sh | bash" >&2
  echo "Depois rode 'agy' uma vez e logue na conta Google AI Pro." >&2
  exit 127
fi

TASK="${1:-}"
[ -z "$TASK" ] && TASK="$(cat)"   # aceita tarefa via stdin também
if [ -z "$TASK" ]; then
  echo "delegate: sem briefing. Uso: delegate [--think low|med|high] [--redo] \"<briefing>\"   (veja delegate --help)" >&2
  exit 2
fi

PROMPT="$TASK

---
COMO AGIR (você é um AGENTE com ferramentas de arquivo e shell — EXECUTE, não simule):
0. SIGA O PROJETO: se existir CLAUDE.md / AGENTS.md / .cursorrules neste diretório (ou
   acima), LEIA e respeite os princípios de engenharia e convenções dele — eles são a
   fonte da verdade do projeto e mandam mais que estas regras genéricas.
1. ATERRE NA REALIDADE: antes de mudar, leia os arquivos/convenções relevantes e use
   grep/glob para achar TODAS as ocorrências. Não edite por amostra nem suponha estrutura.
2. PREFIRA SCRIPT DETERMINÍSTICO: para transform repetitivo/mecânico, escreva um script
   (Python/sed/node) IDEMPOTENTE e RODE-O — NÃO edite arquivo-por-arquivo no olho (arrisca
   lixo no fim, var() quebrado, blocos duplicados). Em casos com julgamento (escopo, valor
   idêntico), o script DETECTA a condição explicitamente, não adivinha.
3. FIQUE CIRÚRGICO: mude só o que foi pedido. Não reformatar, não \"melhorar\" código vizinho,
   não adicionar comentários, não tocar o que não foi solicitado.
4. NA DÚVIDA, PULE E REPORTE: se um caso for ambíguo ou não-idêntico, NÃO adivinhe — deixe
   como está e liste no resumo para revisão humana.
5. VERIFIQUE DE VERDADE: RODE o que existir (testes/build/lint) e itere até passar de fato —
   cole no resumo a saída real do comando, não 'deve passar'. Depois confira 'git diff'
   linha-a-linha (só o pretendido mudou? sem corrupção?) ANTES de responder.
6. ERRO VIRA TESTE: se a tarefa for corrigir um bug em código que tem testes, além de
   corrigir, veja se dá pra reformular de modo que um teste passe a pegá-lo ANTES — mas só
   quando for elegante e fácil, sem quebrar a cirurgia do item 3. Na dúvida, não force.
7. SUBMETIDO NÃO É PRONTO: se o trabalho roda remoto ou em segundo plano (nuvem, Kaggle,
   deploy, cron, nohup), só diga que terminou depois de VER no log real a primeira unidade
   completa terminar E a seguinte começar sem erro. Se não der para esperar, a 1ª linha do
   resumo é 'SUBMETIDO, NÃO VERIFICADO' + qual log conferir. Código gerado por template
   (script dentro de string): compile/rode o ARQUIVO GERADO, não só o gerador. Processo que
   precisa sobreviver a você: 'setsid nohup', senão morre quando você sair.
8. CITAÇÃO SÓ COM FONTE EM DISCO: pesquisa que cita texto (artigo, norma, licença) salva o
   texto-fonte num arquivo; aspas só para trecho copiado dele, corte marcado com [...].
   Se 'conferir-citacoes' existir no PATH, rode-o sobre o entregável e cole a saída. Nunca
   escreva 'conferido'/'validado' sem a saída de um comando que conferiu.

REGRAS DE SAÍDA (obrigatório — o chamador é outra IA que paga tokens por cada linha):
- Faça TODO o trabalho no disco; NÃO despeje diffs nem logs longos na resposta.
- Responda APENAS um resumo curto e estruturado:
  * o que mudou (1-5 linhas) e SE usou script determinístico
  * arquivos tocados (lista de caminhos)
  * verificação: comando(s) que você RODOU e o resultado real (passou? o que corrigiu?)
  * qualquer problema/decisão que precise de revisão do orquestrador."

# Seleção de modelo: `--model <slug>` na linha de comando. Funciona desde o agy 1.1.5, que
# introduziu slugs estáveis aceitos por `--model` (`agy models` lista os válidos). Confirmado
# no log do agy 1.1.8: `Propagating selected model override to backend: label="..."`.
#
# ⚠️ Até 30/07/2026 este script escrevia o modelo em ~/.gemini/antigravity-cli/settings.json,
# porque no agy da época o `--model` era ignorado em print mode. Aquilo era ESTADO GLOBAL: dois
# `delegate` simultâneos (ou um `claude-loop` rodando junto de você) se atropelavam e um ia parar
# no modelo do outro — e o arquivo ficava alterado depois, mudando o modelo da sessão interativa
# do Vladimir sem ele pedir. Com `--model` a escolha é por processo. NÃO reintroduzir.
#
# Guarda: se o agy for anterior ao 1.1.5, `--model` é silenciosamente ignorado — melhor avisar
# do que rodar no modelo errado achando que rodou no certo.
AGY_VER="$(agy --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
if [ -n "$AGY_VER" ] && [ "$(printf '%s\n1.1.5\n' "$AGY_VER" | sort -V | head -1)" != "1.1.5" ]; then
  echo "delegate: aviso — agy $AGY_VER é anterior ao 1.1.5; '--model' pode ser ignorado." >&2
  echo "           rode 'agy update' para garantir que $MODEL seja de fato o modelo usado." >&2
fi
echo "delegate: modelo = $MODEL (agy ${AGY_VER:-?})" >&2

# --add-dir "$PWD": sem isso o agy roda num sandbox próprio e NÃO enxerga o
# diretório de trabalho — edita arquivos no scratch dele, não no projeto.
# $CONTINUE (--continue) quando --redo: continua a última conversa, herdando contexto.
# ⚠️ NÃO passar um `--print` solto: ele ACEITA VALOR (é alias de --prompt) e engolia o
# `--dangerously-skip-permissions` como se fosse o prompt. `-p "$PROMPT"` já é o print mode.
executa_agy() {
  local mod="$1" out="$2" err="$3" cont="$4" prm="$5"
  agy --dangerously-skip-permissions $cont --model "$mod" --add-dir "$PWD" \
      --print-timeout "${DELEGATE_TIMEOUT:-$TIMEOUT_PADRAO}" -p "$prm" >"$out" 2>"$err"
}

bateu_cota() {
  grep -qiE "RESOURCE_EXHAUSTED|quota.*reached|quota.*exceeded|rateLimitExceeded|code[=: ]+429|HTTP/2 429|status.*429" "$1" "$2" 2>/dev/null
}

GIT_ANTES="$(git status --porcelain 2>/dev/null || true)"

AGY_OK=0
if executa_agy "$MODEL" "$RESULT" "$ERR" "$CONTINUE" "$PROMPT"; then
  if [ -s "$RESULT" ] && ! grep -qi "timeout waiting for response" "$RESULT"; then
    AGY_OK=1
  fi
fi

# Se falhou (ou devolveu vazio) por cota esgotada e temos modelo reserva de cota separada:
if [ "$AGY_OK" -eq 0 ] && [ -n "$FALLBACK_MODEL" ] && bateu_cota "$ERR" "$RESULT"; then
  echo "delegate: cota esgotada em $MODEL; alternando automaticamente para $FALLBACK_MODEL..." >&2
  mv "$ERR" "$ERR.primary" 2>/dev/null || true
  mv "$RESULT" "$RESULT.primary" 2>/dev/null || true
  GIT_DEPOIS="$(git status --porcelain 2>/dev/null || true)"
  FALLBACK_CONTINUE="$CONTINUE"
  FALLBACK_PROMPT="$PROMPT"
  if [ "$GIT_ANTES" != "$GIT_DEPOIS" ] && [ -z "$FALLBACK_CONTINUE" ]; then
    echo "delegate: trabalho parcial detectado no disco; retomando a mesma conversa (--continue) em $FALLBACK_MODEL." >&2
    FALLBACK_CONTINUE="--continue"
    FALLBACK_PROMPT="A execução anterior foi interrompida por limite de cota do modelo anterior no meio da tarefa. Continue de onde parou, revise o que já foi alterado com git status/git diff, conclua os itens restantes, rode os testes e entregue o resumo final seguindo as regras originais."
  fi
  echo "delegate: modelo = $FALLBACK_MODEL (fallback de cota; agy ${AGY_VER:-?})" >&2
  if executa_agy "$FALLBACK_MODEL" "$RESULT" "$ERR" "$FALLBACK_CONTINUE" "$FALLBACK_PROMPT"; then
    if [ -s "$RESULT" ] && ! grep -qi "timeout waiting for response" "$RESULT"; then
      AGY_OK=1
    fi
  fi
fi

if [ "$AGY_OK" -eq 0 ]; then
  if [ ! -s "$RESULT" ] || grep -qi "timeout waiting for response" "$RESULT"; then
    echo "DELEGATE_FAILED — agy devolveu vazio/timeout. Trabalho PARCIAL pode estar no disco:" >&2
    echo "  confira 'git status' antes de re-delegar; re-briefe só o que falta. Saída: $RESULT" >&2
    if [ -s "$ERR" ]; then echo "  stderr do agy ($ERR):" >&2; tail -n 20 "$ERR" >&2; fi
  else
    echo "DELEGATE_FAILED — veja $ERR" >&2
    tail -n 20 "$ERR" >&2 || true
  fi
  exit 1
fi

echo "✓ Antigravity terminou. Saída completa em: $RESULT"
echo "--- RESUMO ---"
# agy --print devolve texto puro (o resumo estruturado pedido no prompt).
cat "$RESULT"
